{
  "manifest_version": 3,
  "name": "AI Tab Organizer",
  "version": "0.1.0",
  "description": "AI-powered tab organization and management",
  "permissions": ["tabs", "storage", "scripting", "activeTab", "bookmarks"],
  "host_permissions": ["https://api.anthropic.com/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
